{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "border": {
      "radius": true,
      "color": true,
      "width": true
    },
    "color": {
      "custom": false,
      "link": true,
      "defaultGradients": false,
      "defaultPalette": false,
      "palette": [
        { "name": "Primary",   "slug": "primary",   "color": "#A5A4BF" },
        { "name": "Secondary", "slug": "secondary", "color": "#5C5F35" },
        { "name": "Tertiary",  "slug": "tertiary",  "color": "#91615A" },
        { "name": "Offwhite",  "slug": "offwhite",  "color": "#FAF3EE" },
        { "name": "Gray",      "slug": "gray",      "color": "#B6B0B9" },
        { "name": "Contrast",  "slug": "contrast",  "color": "#000000" },
        { "name": "Base",      "slug": "base",      "color": "#ffffff" }
      ]
    },
    "spacing": {
      "margin": true,
      "padding": true,
      "blockGap": true,
      "units": ["px", "%", "em", "rem", "vw"],
      "spacingScale": {
        "operator": "+",
        "increment": 1,
        "steps": 7,
        "mediumStep": 2,
        "unit": "rem"
      }
    },
    "layout": {
      "contentSize": "1040px",
      "wideSize": "1440px"
    },
    "typography": {
      "customFontSize": false,
      "lineHeight": true,
      "dropCap": false,
      "fontStyle": true,
      "fontWeight": true,
      "letterSpacing": false,
      "textDecoration": true,
      "textTransform": true,
      "fontFamilies": [
        {
          "fontFamily": "\"Outfit\", sans-serif",
          "slug": "outfit",
          "name": "Outfit"
        }
      ],
      "fontSizes": [
        { "slug": "level-0", "size": "1rem", "name": "Small" },
        { "slug": "level-1", "size": "1.25rem", "name": "Base" },
        { "slug": "level-2", "size": "1.35rem", "name": "Large" },
        { "slug": "level-3", "size": "1.8rem", "name": "H4" },
        { "slug": "level-4", "size": "2.5rem", "name": "H3" },
        { "slug": "level-5", "size": "4rem", "name": "H2" },
        { "slug": "level-6", "size": "4.75rem", "name": "H1" }
      ]
    },
    "custom": {
      "spacing": {
        "baseline": "2rem"
      }
    },
    "useRootPaddingAwareAlignments": true
  },
  "styles": {
    "spacing": {
      "padding": {
        "top": "0",
        "right": "24px",
        "bottom": "0",
        "left": "24px"
      }
    },
    "color": {
      "text": "var(--wp--preset--color--contrast)"
    },
    "typography": {
      "lineHeight": "1.5",
      "fontFamily": "\"Outfit\", sans-serif"
    },
    "elements": {
      "h1": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--level-6)",
          "fontWeight": "700",
          "lineHeight": "1.1"
        }
      },
      "h2": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--level-5)",
          "fontWeight": "700",
          "lineHeight": "1.15"
        }
      },
      "h3": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--level-4)",
          "fontWeight": "600",
          "lineHeight": "1.2"
        }
      },
      "h4": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--level-3)",
          "fontWeight": "600",
          "lineHeight": "1.25"
        }
      },
      "h5": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--level-2)",
          "fontWeight": "600",
          "lineHeight": "1.3"
        }
      },
      "h6": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--level-1)",
          "fontWeight": "600",
          "lineHeight": "1.3"
        }
      }
    }
  }
}